# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# MongoDB connection (local or MongoDB Atlas). Without it the site runs on built-in demo data.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=master_ji_city_complete

# Admin PIN for the School Management section (/school). Choose your own.
# In production the section stays locked until this is set. (Development falls back to 1234.)
ADMIN_PIN=

# AI Doubt Solver (Claude). Get a key at https://platform.claude.com - without it, doubts are answered from built-in notes.
# ANTHROPIC_API_KEY=

# ---- Super Admin Panel (admin/) ----
ADMIN_PORT=5050
# Long random secret for admin sessions (required in production): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
# First Super Admin - created on first start; must change the password at first login.
# Use your own email and a strong password (8+ characters, letters and numbers).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
